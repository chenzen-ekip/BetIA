// Base de données simple pour NextAuth
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String    // ID de l'utilisateur Clerk
  title     String    // Titre de la conversation (ex: "PSG vs OM")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  role           String       // "user" ou "assistant"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AnalysisCache {
  id        String   @id @default(cuid())
  queryHash String   @unique // Hash ou version nettoyée de la question utilisateur
  response  String   @db.Text // La réponse complète de l'IA
  createdAt DateTime @default(now())
  expiresAt DateTime // Date d'expiration du cache (ex: minuit le soir même)

  @@index([queryHash])
  @@index([expiresAt])
}

// --- DATA ENGINE MODELS ---

model League {
  id        String   @id @default(cuid())
  apiId     Int      @unique // ID from API-Football
  name      String
  country   String?
  logo      String?
  season    Int      // Current season year
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id          String   @id @default(cuid())
  apiId       Int      @unique // ID from API-Football
  name        String
  code        String?  // e.g. "PSG"
  country     String?
  logo        String?
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Match {
  id          String   @id @default(cuid())
  apiId       Int      @unique // ID from API-Football
  date        DateTime
  status      String   // "SCHEDULED", "LIVE", "FINISHED", "POSTPONED"
  
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id])
  
  homeTeamId  String
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  
  awayTeamId  String
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  
  homeScore   Int?
  awayScore   Int?
  
  predictions Prediction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([leagueId])
}

model Prediction {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  type        String   // "WINNER", "OVER_UNDER", "BTTS"
  selection   String   // "HOME", "OVER_2.5", "YES"
  probability Float?   // 0.0 to 1.0
  confidence  String?  // "HIGH", "MEDIUM", "LOW"
  analysis    String?  @db.Text // Short justification
  
  isCorrect   Boolean? // Null = pending, True = won, False = lost
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([matchId])
}
